{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 .github/hooks/launch.py session_start",
        "windows": "py -3 .github\\hooks\\launch.py session_start",
        "cwd": ".",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/launch.py guard",
        "windows": "py -3 .github\\hooks\\launch.py guard",
        "cwd": ".",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .github/hooks/launch.py stop_check",
        "windows": "py -3 .github\\hooks\\launch.py stop_check",
        "cwd": ".",
        "timeout": 25
      }
    ]
  }
}
